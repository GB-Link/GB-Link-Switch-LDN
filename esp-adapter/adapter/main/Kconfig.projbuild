menu "Bridge link"

config GB_LINK_TX_GPIO
    int "TX, to the bridge board's RX"
    default 17 if IDF_TARGET_ESP32
    default 7 if IDF_TARGET_ESP32S3
    default 19 if IDF_TARGET_ESP32C6
    default 2

config GB_LINK_RX_GPIO
    int "RX, from the bridge board's TX"
    default 16 if IDF_TARGET_ESP32
    default 8 if IDF_TARGET_ESP32S3
    default 20 if IDF_TARGET_ESP32C6
    default 1

endmenu
