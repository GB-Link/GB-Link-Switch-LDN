#include "rfu_link.h"

#include "driver/gpio.h"
#include "esp_attr.h"
#include "esp_cpu.h"
#include "freertos/FreeRTOS.h"
#include "soc/gpio_reg.h"
#include "soc/io_mux_reg.h"
#include "esp_rom_sys.h"

// Raw single-register GPIO access. Every link pin lives in the 0-31 bank, so a
// read is one load and a level change is one store -- the hot loop below has to
// keep up with a 2 MHz SC (250 ns per half-bit).
#define SC_MASK (1u << RFU_PIN_SC)
#define SO_MASK (1u << RFU_PIN_SO)
#define SI_MASK (1u << RFU_PIN_SI)

static inline IRAM_ATTR bool sc_high(void) { return (REG_READ(GPIO_IN_REG) & SC_MASK) != 0; }
static inline IRAM_ATTR bool so_high(void) { return (REG_READ(GPIO_IN_REG) & SO_MASK) != 0; }
static inline IRAM_ATTR void si_set(bool high)
{
    if (high) REG_WRITE(GPIO_OUT_W1TS_REG, SI_MASK); else REG_WRITE(GPIO_OUT_W1TC_REG, SI_MASK);
}
static inline IRAM_ATTR void sc_set(bool high)
{
    if (high) REG_WRITE(GPIO_OUT_W1TS_REG, SC_MASK); else REG_WRITE(GPIO_OUT_W1TC_REG, SC_MASK);
}
static inline void sc_drive(bool enable)
{
    if (enable) REG_WRITE(GPIO_ENABLE_W1TS_REG, SC_MASK); else REG_WRITE(GPIO_ENABLE_W1TC_REG, SC_MASK);
}

static rfu_transfer_done_t g_done_cb;
static void *g_done_user;
static volatile rfu_role_t g_role = RFU_ROLE_GBA_MASTER;
static volatile bool g_enabled;
static volatile uint32_t g_staged_tx;      // the one word kept staged for GBA-master role
static volatile bool g_sd_latched;
static uint32_t g_slave_words, g_master_words, g_partial;
// Where partial words die. Bit 0 means we never saw a second edge -- a false
// start. A spread across higher bits means we are genuinely too slow mid-word.
static uint32_t g_partialAtBit0, g_partialLate, g_glitches;
// Consecutive polls that saw SC high. A word is 16 us at 2 MHz and the GBA's
// inter-word gap is >=40 us, so a run well past one word means we are between
// words rather than between bits.
static uint32_t g_highRun;
static uint32_t g_polls;   // sampling rate: the decisive number for a bit-banged 2 MHz wire
#define IDLE_GAP_POLLS 512
static uint8_t g_lastPartialBit;

// A whole word is 125 us at 256 kHz and 16 us at 2 MHz, so this only has to
// outlast one word plus the GBA's inter-bit jitter. Keeping it tight matters:
// the word runs with interrupts disabled, so a false start (a glitch on SC read
// as a falling edge) blocks for the whole budget and can swallow the real word
// behind it.
#define WORD_TIMEOUT_US 400

// Timing uses the CPU cycle counter, not esp_timer: it is a register read with
// no call into flash-resident code, so it keeps working when the cache is off.
// NOTE: a flash write on the other core stalls THIS core outright, which would
// corrupt a word in flight. Avoid NVS/flash writes while a session is running.
static inline IRAM_ATTR uint32_t cycles(void) { return esp_cpu_get_cycle_count(); }
#define CYCLES_PER_US (CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ)

static void IRAM_ATTR sd_isr(void *arg) { (void)arg; g_sd_latched = true; }

void rfu_link_set_done_callback(rfu_transfer_done_t cb, void *user)
{
    g_done_user = user;
    g_done_cb = cb;
}

void rfu_link_enable(void)
{
    if (g_enabled) return;

    // SC and SO are driven by the GBA and idle high; bias them so a floating
    // line cannot be mistaken for a falling edge and slip every word by a bit.
    gpio_config_t in_cfg = {
        .pin_bit_mask = (1ULL << RFU_PIN_SC) | (1ULL << RFU_PIN_SO),
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    gpio_config(&in_cfg);

    // Seed SI low before enabling the output: a real adapter rests its data
    // line low to mean "ready", and the GBA samples it immediately.
    gpio_set_level(RFU_PIN_SI, 0);
    gpio_config_t out_cfg = {
        .pin_bit_mask = 1ULL << RFU_PIN_SI,
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    gpio_config(&out_cfg);
    si_set(false);

    // SD carries the game's soft-reset pulse -- well under a millisecond, so it
    // is edge-latched in an ISR rather than polled.
    gpio_config_t sd_cfg = {
        .pin_bit_mask = 1ULL << RFU_PIN_SD,
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_ENABLE,
        .intr_type = GPIO_INTR_POSEDGE,
    };
    gpio_config(&sd_cfg);
    gpio_install_isr_service(ESP_INTR_FLAG_IRAM);
    gpio_isr_handler_add(RFU_PIN_SD, sd_isr, NULL);
    g_sd_latched = false;

    g_staged_tx = 0;  // RESET-state response
    g_role = RFU_ROLE_GBA_MASTER;
    g_enabled = true;
}

void rfu_link_disable(void)
{
    if (!g_enabled) return;
    g_enabled = false;
    gpio_isr_handler_remove(RFU_PIN_SD);
    sc_drive(false);
}

void rfu_link_push_tx(uint32_t word) { g_staged_tx = word; }
rfu_role_t rfu_link_get_role(void) { return g_role; }
bool rfu_link_gba_line_high(void) { return so_high(); }

bool rfu_link_sd_reset_seen(void)
{
    if (!g_sd_latched) return false;
    g_sd_latched = false;
    return true;
}

bool rfu_link_enabled(void) { return g_enabled; }

uint8_t rfu_link_levels(void)
{
    const uint32_t in = REG_READ(GPIO_IN_REG);
    const uint32_t out = REG_READ(GPIO_OUT_REG);
    return (uint8_t)(((in & SC_MASK) ? 1 : 0) | ((in & SO_MASK) ? 2 : 0) |
                     ((out & SI_MASK) ? 4 : 0) | ((in & (1u << RFU_PIN_SD)) ? 8 : 0));
}

void rfu_link_stats(uint32_t *slave_words, uint32_t *master_words, uint32_t *partial)
{
    if (slave_words) *slave_words = g_slave_words;
    if (master_words) *master_words = g_master_words;
    if (partial) *partial = g_partial;
}

void rfu_link_partial_detail(uint32_t *at_bit0, uint32_t *late, uint8_t *last_bit)
{
    if (at_bit0) *at_bit0 = g_partialAtBit0;
    if (late) *late = g_partialLate;
    if (last_bit) *last_bit = g_lastPartialBit;
}

uint32_t rfu_link_glitches(void) { return g_glitches; }

uint32_t rfu_link_polls(void) { return g_polls; }

bool rfu_link_idle_gap(void) { return g_highRun >= IDLE_GAP_POLLS; }

// One word as the GBA's slave. Entered with SC already low (the caller saw the
// falling edge), so bit 31 is driven immediately and sampled on the rise.
// Interrupts stay off for the whole word: at 2 MHz it lasts ~16 us, and a
// preemption mid-word would slip every remaining bit.
// Guard iterations per edge. The inner loops must not read the cycle counter:
// at 2 MHz a half-bit is 250 ns, so every cycle spent on bookkeeping costs
// samples. A plain decrement is ~2 cycles against ~8 for RSR CCOUNT plus a
// compare. Sized generously against the slowest case (256 kHz, ~2 us per half
// bit) while still bounding a false start to a few microseconds.
#define EDGE_GUARD 4000

static bool IRAM_ATTR slave_word(uint32_t tx, uint32_t *rx_out, uint8_t *failed_bit)
{
    uint32_t rx = 0;

    for (int bit = 0; bit < 32; ++bit)
    {
        uint32_t guard;
        // Falling edge already seen for bit 0; for the rest, wait for it.
        if (bit != 0)
        {
            guard = EDGE_GUARD;
            while (sc_high())
                if (--guard == 0) { *failed_bit = (uint8_t)bit; return false; }
        }
        si_set((tx & 0x80000000u) != 0);
        tx <<= 1;

        guard = EDGE_GUARD;
        while (!sc_high())  // rising edge: the GBA latches our bit, we take its
            if (--guard == 0) { *failed_bit = (uint8_t)bit; return false; }
        rx = (rx << 1) | (so_high() ? 1u : 0u);
    }
    *rx_out = rx;
    return true;
}

void IRAM_ATTR rfu_link_poll(void)
{
    if (!g_enabled || g_role != RFU_ROLE_GBA_MASTER) return;
    ++g_polls;

    if (sc_high())
    {
        // Idle-gap mirror: SI = NOT SO for as long as SC rests high. This is
        // what releases librfu's inter-word handshake_wait busy-waits.
        si_set(!so_high());
        if (g_highRun < IDLE_GAP_POLLS) ++g_highRun;
        return;
    }
    g_highRun = 0;

    // Confirm the low before committing. A real word start holds SC low for
    // 250 ns at 2 MHz -- many consecutive reads -- so a second look costs
    // nothing, while a single-sample glitch is rejected outright. Without this,
    // noise on the clock line produced ~1000 phantom word starts in 30 s, each
    // burning the whole edge guard with interrupts disabled and going blind to
    // real traffic while it did.
    if (sc_high()) { ++g_glitches; return; }

    // SC fell: a word is starting. Take the staged response and clock it out.
    uint32_t tx = g_staged_tx, rx = 0;
    uint8_t failed_bit = 0;
    portDISABLE_INTERRUPTS();
    bool ok = slave_word(tx, &rx, &failed_bit);
    portENABLE_INTERRUPTS();

    if (!ok)
    {
        ++g_partial;
        g_lastPartialBit = failed_bit;
        if (failed_bit == 0) ++g_partialAtBit0; else ++g_partialLate;
        return;
    }
    ++g_slave_words;
    if (g_done_cb) g_done_cb(rx, g_done_user);
}

void rfu_link_set_role(rfu_role_t role)
{
    if (!g_enabled || role == g_role) return;

    if (role == RFU_ROLE_ADAPTER_MASTER)
    {
        // Take SC over without ever letting it dip: the GBA armed itself as an
        // external-clock slave and counts EVERY edge as a data bit. Seed the
        // output latch high FIRST, and only then enable the driver, so the pin
        // is handed over at the level it already rests at.
        sc_set(true);
        si_set(false);  // ready lead-in
        sc_drive(true);
    }
    else
    {
        // Release SC back to the GBA. The latch is high from the master park,
        // so dropping the driver hands over at the same level -- no edge.
        sc_set(true);
        sc_drive(false);
    }
    g_role = role;
}

void rfu_link_master_drive_si(bool high)
{
    if (g_role == RFU_ROLE_ADAPTER_MASTER) si_set(high);
}

// One word as bus master, mirroring the slave geometry: drive our bit with the
// falling edge, sample the GBA's mid-low (it shifts SO on the fall), and let
// the rising edge latch our bit into it. ~154 kHz, matching the Pico, which is
// well inside librfu's 100.2 ms inter-word slave timer.
// ~154 kHz, matching the Pico: 3 us low and 3 us high per bit. The GBA-as-slave
// is edge-driven and rate-tolerant; each word only has to land inside librfu's
// 100.2 ms inter-word slave timer.
#define MASTER_HALF_CYCLES ((uint32_t)3 * CYCLES_PER_US)

static inline IRAM_ATTR void busy_wait_cycles(uint32_t n)
{
    const uint32_t start = cycles();
    while (cycles() - start < n) { }
}

bool IRAM_ATTR rfu_link_master_exchange(uint32_t word, uint32_t *rx, uint32_t timeout_us)
{
    (void)timeout_us;  // the exchange has no external dependency; it cannot block
    if (!g_enabled || g_role != RFU_ROLE_ADAPTER_MASTER) return false;

    uint32_t in = 0;
    portDISABLE_INTERRUPTS();
    for (int bit = 0; bit < 32; ++bit)
    {
        sc_set(false);
        si_set((word & 0x80000000u) != 0);
        word <<= 1;
        busy_wait_cycles(MASTER_HALF_CYCLES / 2);
        in = (in << 1) | (so_high() ? 1u : 0u);  // mid-low: the bit it shifted at the fall
        busy_wait_cycles(MASTER_HALF_CYCLES - MASTER_HALF_CYCLES / 2);
        sc_set(true);                            // rising edge: the GBA latches our bit
        busy_wait_cycles(MASTER_HALF_CYCLES);
    }
    portENABLE_INTERRUPTS();

    ++g_master_words;
    if (rx) *rx = in;
    return true;
}
