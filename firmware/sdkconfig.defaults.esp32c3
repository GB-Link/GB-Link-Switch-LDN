CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# The C3 has the least RAM of these chips, and its code RAM and data RAM are the same
# memory: Wi-Fi's receive and hot-path code runs from flash instead, the Wi-Fi buffers are
# trimmed as on the original ESP32 (Switch networks are 802.11b/g, no aggregation), so is
# the zstd decoder's literal buffer, and the USB console buffers are cut to 8 KB and 4 KB.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_PIA_ZSTD_LITERAL_BUFFER=1024
CONFIG_BRIDGE_USB_RX_BUFFER=8192
CONFIG_BRIDGE_USB_TX_BUFFER=4096
# 8.5 dBm: some C3 boards garble their frames at full power and never get a join answered.
CONFIG_BRIDGE_WIFI_MAX_TX_POWER=34
